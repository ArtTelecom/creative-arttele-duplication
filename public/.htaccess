# SPA fallback — все маршруты отдаём React Router через index.html
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # index.html не трогаем
    RewriteRule ^index\.html$ - [L]

    # Реальные файлы и папки отдаём как есть
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d

    # Всё остальное — на index.html
    RewriteRule . /index.html [L]
</IfModule>

# Кеширование статики
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# Сжатие
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

# Файл для теста скорости — без кеша и без сжатия, чтобы замер был честным
<IfModule mod_headers.c>
    <Files "speedtest.bin">
        Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
        Header set Content-Type "application/octet-stream"
        SetEnv no-gzip 1
    </Files>
</IfModule>

# Приёмник отдачи (upload) теста скорости — увеличиваем лимиты и снимаем кеш
<Files "upload.php">
    <IfModule mod_headers.c>
        Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
    </IfModule>
    # Разрешаем крупное тело запроса (до ~200 МБ) для честного замера
    <IfModule mod_php.c>
        php_value post_max_size 256M
        php_value upload_max_filesize 256M
        php_value max_input_time 60
    </IfModule>
    <IfModule mod_php7.c>
        php_value post_max_size 256M
        php_value upload_max_filesize 256M
    </IfModule>
    <IfModule mod_php8.c>
        php_value post_max_size 256M
        php_value upload_max_filesize 256M
    </IfModule>
</Files>
# Лимит размера тела на уровне Apache (если модуль доступен)
<IfModule mod_reqtimeout.c>
    RequestReadTimeout body=60
</IfModule>